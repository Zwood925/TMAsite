---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Services & Capabilities | The Mushroom Agency">
  <Navbar />

  <main class="container">
    <header class="services-header">
      <h1 class="section-title">If you can think of it,<br><span class="text-emerald-400">We can build it.</span></h1>
      <p class="subtitle-desc">
        Traditional dev shops charge legacy enterprise rates for snail-pace delivery. We leverage modern AI orchestration and custom engineering to ship production-ready software in days, not months.
      </p>
    </header>

<!-- THE MANIFESTO VIDEO TERMINAL -->
    <section class="video-manifesto-section">
      <div class="video-terminal-wrapper">
        <video 
          controls 
          preload="metadata"
          poster="/tma-poster.jpg" 
          class="manifesto-video"
        >
          <source src="/tma_ad.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>
    </section>

    <!-- CORE CAPABILITIES GRID -->
    <section class="core-services">
      
      <!-- Precision Landing Pages & Launchpads -->
      <div class="service-block glass-box">
        <div class="service-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/><path d="M12 2v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 6.34 1.41-1.41"/></svg>
        </div>
        <div class="service-text">
          <h3>High-Converting Launchpads</h3>
          <p>No bloated page builders. We design and build ultra-fast, high-converting landing pages built on modern frameworks optimized for maximum conversion and instant load times.</p>
        </div>
      </div>

      <!-- Voice & Audio -->
      <div class="service-block glass-box">
        <div class="service-icon text-amber-400 bg-amber-400/10 border-amber-400/20">
          <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
        </div>
        <div class="service-text">
          <h3>Autonomous Voice Agents</h3>
          <p>Stop missing leads. We build custom AI voice agents that answer your phone, book appointments, and handle customer service 24/7 using high-fidelity voice cloning.</p>
        </div>
      </div>

      <!-- Private LLMs -->
      <div class="service-block glass-box">
        <div class="service-icon text-emerald-400 bg-emerald-400/10 border-emerald-400/20">
          <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
        </div>
        <div class="service-text">
          <h3>Private Enterprise LLMs</h3>
          <p>Secure your proprietary data. We train and deploy custom Large Language Models exclusively on your company's documents, keeping your workflows completely private.</p>
        </div>
      </div>

      <!-- Web & E-Commerce -->
      <div class="service-block glass-box">
        <div class="service-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
        </div>
        <div class="service-text">
          <h3>Bespoke Web Platforms</h3>
          <p>From sleek storefronts for niche consumer products to complex, multi-tenant industrial field applications, we engineer full-stack web software designed to scale effortlessly.</p>
        </div>
      </div>

    </section>

    <!-- THE GUARANTEE -->
    <section class="guarantee-section glass-box relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-emerald-900/20 to-black pointer-events-none"></div>
      <div class="guarantee-content relative z-10">
        <h2 class="text-amber-400">The "Own Your Stack" Guarantee</h2>
        <p>Stop paying perpetual monthly fees for rented software and rigid SaaS templates. We engineer self-hosted, custom solutions where you maintain 100% ownership, full root access, and total source code control.</p>
      </div>
    </section>

    <!-- CTA SECTION -->
    <section class="services-cta text-center">
      <h2>Ready to build your next tool?</h2>
      <a href="/contact" class="btn primary-btn mt-4 inline-block bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 px-8 rounded-xl transition-all">Initiate Contact</a>
    </section>
  </main>
</Layout>

<style>
  .container {
    position: relative;
    z-index: 10;
    max-width: 1200px;
    margin: 0 auto;
    padding: 8rem 2rem 4rem 2rem;
  }

  .services-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    color: #fff;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .subtitle-desc {
    color: #94a3b8;
    font-size: 1.25rem;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Core Services - Upgraded to 2-Column Grid */
  .core-services {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 1024px) {
    .core-services {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .service-block {
    display: flex;
    flex-direction: column;
    padding: 2.5rem;
    gap: 1.5rem;
    transition: all 0.3s ease;
    background: rgba(20, 20, 24, 0.6);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 1rem;
  }

  @media (min-width: 640px) {
    .service-block {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .service-block:hover {
    border-color: rgba(16, 185, 129, 0.4);
    box-shadow: 0 10px 40px rgba(16, 185, 129, 0.05);
    transform: translateY(-5px);
  }

  .service-icon {
    flex-shrink: 0;
    color: #c084fc;
    background: rgba(168, 85, 247, 0.1);
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    border: 1px solid rgba(168, 85, 247, 0.2);
  }

  .service-text h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  .service-text p {
    color: #cbd5e1;
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Guarantee Section */
  .guarantee-section {
    padding: 4rem 2rem;
    text-align: center;
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 1.5rem;
    margin-bottom: 4rem;
  }

  .guarantee-content h2 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .guarantee-content p {
    color: #e2e8f0;
    font-size: 1.2rem;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .services-cta {
    padding: 2rem 0;
  }

  .services-cta h2 {
    font-size: 2rem;
    color: #fff;
  }
  /* Manifesto Video Overrides */
  .video-manifesto-section {
    width: 100%;
    max-width: 100vw;
    margin-bottom: 4rem;
    box-sizing: border-box;
  }

  .video-terminal-wrapper {
    position: relative;
    width: 100%;
    max-width: 900px; /* Caps the size on desktop */
    margin: 0 auto;
    border-radius: 16px;
    overflow: hidden; /* Ensures the video doesn't break the rounded corners */
    border: 1px solid rgba(245, 158, 11, 0.3);
    background: #000;
    box-shadow: 0 0 40px rgba(245, 158, 11, 0.1);
  }

  .manifesto-video {
    display: block;
    width: 100%; /* Forces the video to match the wrapper width */
    max-width: 100%;
    height: auto; /* Keeps the proportions correct */
    aspect-ratio: 16 / 9; /* Tells the browser the exact shape of the video */
    object-fit: contain; /* Prevents cropping */
    background: #000;
  }
  
</style>