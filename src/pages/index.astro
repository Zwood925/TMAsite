---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="The Mushroom Agency | Custom Tech & AI">
  <Navbar />
  
  <main class="container">
    <!-- HERO SECTION -->
    <section class="hero glass-box">
      <div class="hero-split">
        <div class="hero-text">
          <h1 class="neon-title">The Mushroom Agency</h1>
          <h2 class="subtitle">Traditional development takes months. <span class="highlight">We build in days.</span></h2>
          
          <p class="description">
            By leveraging advanced AI workflows, custom agents, and high-level tech orchestration, we rapidly deploy custom code, full-stack apps, and automated workflows without the legacy development timelines.
          </p>

          <div class="button-group">
            <a href="/work" class="btn primary-btn">View Projects</a>
            <a href="/contact" class="btn secondary-btn">Let's Build</a>
          </div>
        </div>
        <div class="hero-visual">
          <video src="/glowing_shroom.mp4" autoplay loop muted playsinline class="floating-shroom"></video>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .container {
    position: relative;
    z-index: 10;
    max-width: 1100px;
    margin: 0 auto;
    padding: 8rem 2rem 4rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Hero Section */
  .hero {
    padding: 4rem 3rem;
    width: 100%;
  }

  .hero-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 850px) {
    .hero-split {
      grid-template-columns: 1.2fr 0.8fr;
      text-align: left;
    }
    .button-group {
      justify-content: flex-start;
    }
    .description {
      margin: 0 0 3rem 0;
    }
  }

  .floating-shroom {
    width: 100%;
    max-width: 400px;
    border-radius: 20px;
    box-shadow: 0 0 40px rgba(168, 85, 247, 0.3);
    animation: float 6s ease-in-out infinite;
    display: block;
    margin: 0 auto;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  .neon-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 900;
    background: linear-gradient(to right, #c084fc, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: #e2e8f0;
    font-weight: 500;
    margin-bottom: 2rem;
  }

  .description {
    font-size: 1.125rem;
    color: #94a3b8;
    max-width: 700px;
    margin: 0 auto 3rem auto;
  }

  .button-group {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>