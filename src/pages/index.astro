---
// Server-side logic goes here if needed later
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Mushroom Agency | Custom Tech & AI</title>
  </head>
  <body>
    <!-- Background Magic -->
    <div class="glow-orb"></div>
    <div class="noise-overlay"></div>

    <!-- Simple Nav -->
    <nav class="navbar">
      <div class="logo">🍄 TMA</div>
      <div class="nav-links">
        <a href="#services">Services</a>
        <a href="#portfolio">Work</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>

    <main class="container">
      
      <!-- HERO SECTION -->
      <section class="hero glass-box">
        <div class="hero-split">
          <div class="hero-text">
            <h1 class="neon-title">The Mushroom Agency</h1>
            <h2 class="subtitle">Traditional development takes months. <span class="highlight">We build in days.</span></h2>
            
            <p class="description">
              By leveraging advanced AI workflows, custom agents, and high-level tech orchestration, we rapidly deploy custom code, full-stack apps, and automated workflows without the legacy development timelines.
            </p>

            <div class="button-group">
              <a href="#portfolio" class="btn primary-btn">View Projects</a>
              <a href="#contact" class="btn secondary-btn">Let's Build</a>
            </div>
          </div>
          <div class="hero-visual">
            <video src="/glowing_shroom.mp4" autoplay loop muted playsinline class="floating-shroom"></video>
          </div>
        </div>
      </section>

      <!-- SERVICES SECTION -->
      <section id="services" class="services-section">
        <h2 class="section-title">What We <span class="highlight">Do</span></h2>
<div class="services-grid">
          <div class="service-card">
            <div class="icon">💻</div>
            <h3>Web & App Dev</h3>
            <p>From high-converting landing pages to complex, full-stack web applications built from scratch.</p>
          </div>
          <div class="service-card">
            <div class="icon">🤖</div>
            <h3>AI & Automation</h3>
            <p>Custom chatbots, autonomous AI agents, and workflow automations to put your business on autopilot.</p>
          </div>
          <div class="service-card">
            <div class="icon">🧠</div>
            <h3>Local LLMs</h3>
            <p>Private, locally-hosted language models trained specifically on your company's data and documents.</p>
          </div>
          <!-- THE NEW CONSULTING CARD -->
          <div class="service-card">
            <div class="icon">🔮</div>
            <h3>Tech & Strategy Consulting</h3>
            <p>Need high-level architecture advice? I'll help you map out the exact technical blueprint to crush your goals.</p>
          </div>
        </div>      </section>

      <!-- PORTFOLIO SECTION -->
      <section id="portfolio" class="portfolio-section">
        <h2 class="section-title">Featured <span class="highlight">Projects</span></h2>
        
        <div class="project-grid">
          <!-- Project 1: HappyMe+ -->
          <div class="project-card" 
               data-title="HappyMe+ Web App" 
               data-desc="A dynamic, high-performance social web application built to connect users, manage groups (Pods), and share daily updates. Features include custom feeds, invite systems, and interactive UI components." 
               data-img="/happyme2.PNG" 
               data-link="https://happy-me-plus.vercel.app/">
            <div class="project-content">
              <h3>HappyMe+ Web App</h3>
              <p>A dynamic, high-performance social web app built to connect users and share daily updates.</p>
              <div class="tech-stack">
                <span>Next.js</span>
                <span>React</span>
                <span>Tailwind</span>
              </div>
            </div>
          </div>

          <!-- Project 2: Discord Bot -->
          <div class="project-card" 
               data-title="AI Discord Agents" 
               data-desc="Custom Python scripts integrated with Discord to create autonomous, interactive AI bots. Features include contextual memory, database querying, and dynamic response formatting for user commands." 
               data-img="/dbot_py_screenshot.png" 
               data-link="#">
            <div class="project-content">
              <h3>AI Discord Agents</h3>
              <p>Custom Python scripts integrated with Discord's frontend to create autonomous, interactive AI bots.</p>
              <div class="tech-stack">
                <span>Python</span>
                <span>Discord API</span>
                <span>LLMs</span>
              </div>
            </div>
          </div>

          <!-- Project 3: Landing Page -->
          <div class="project-card" 
               data-title="Custom Web Design" 
               data-desc="High-converting, lightning-fast landing pages and websites designed specifically for client branding and lead generation. (P.S. The site you're looking at right now? Built by me, too!)" 
               data-img="/sacdl1.png" 
               data-link="#">
            <div class="project-content">
              <h3>Custom Web Design</h3>
              <p>High-converting, lightning-fast landing pages and websites designed specifically for client branding.</p>
              <div class="tech-stack">
                <span>Astro</span>
                <span>HTML/CSS</span>
                <span>UI/UX</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CONTACT SECTION -->
      <section id="contact" class="contact-section">
        <div class="contact-card glass-box">
          <div class="contact-split">
            <div class="contact-visual">
              <video src="/tma_pulsing.mp4" autoplay loop muted playsinline class="weird-bounce-logo"></video>
              <h2>Ready to build something weird?</h2>
              <p>Whether you need a custom AI agent, a full-stack application, or just some high-level technical guidance, let's talk.</p>
              
              <div class="calendly-box">
                <h3>Want to skip the form?</h3>
                <p>Book a discovery call directly on my calendar.</p>
                <a href="https://calendly.com/zwood925/tma-discovery-call" target="_blank" rel="noopener noreferrer" class="btn secondary-btn">Book a Call</a>
              </div>
              
              <!-- Decorative Mushroom -->
              <img src="/ChatGPTImageJul24202508_24_12PM.png" alt="Psychedelic Mushroom" class="contact-mushroom" />
            </div>
            
            <div class="contact-form-container">
              <form id="tma-contact-form" class="custom-form">
                <!-- Honeypot & Timestamp for bot protection -->
                <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />
                <input type="hidden" name="timestamp" id="timestamp" />
                
                <div class="form-row">
                  <div class="input-group">
                    <label for="firstName">First Name</label>
                    <input type="text" id="firstName" name="firstName" required minlength="2" placeholder="John" />
                  </div>
                  <div class="input-group">
                    <label for="lastName">Last Name</label>
                    <input type="text" id="lastName" name="lastName" required minlength="2" placeholder="Doe" />
                  </div>
                </div>
                
                <div class="input-group">
                  <label for="email">Email</label>
                  <input type="email" id="email" name="email" required placeholder="john@example.com" />
                </div>

                <div class="input-group">
                  <label for="phone">Phone</label>
                  <input type="tel" id="phone" name="phone" required pattern="[0-9]{10}" placeholder="10-digit number" title="Please enter exactly 10 digits" />
                </div>
                
                <div class="input-group">
                  <label for="message">What are we building?</label>
                  <textarea id="message" name="message" rows="4" required minlength="10" placeholder="Tell me about your project..."></textarea>
                </div>
                
                <button type="submit" class="btn primary-btn submit-btn" id="submit-btn">Send Transmission</button>
              </form>
              
              <div id="form-status" class="form-status hidden">
                <h3>Transmission Received 🍄</h3>
                <p>I'll be in touch with you shortly.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

    </main>

    <!-- MODAL OVERLAY -->
    <div id="project-modal" class="modal-overlay hidden">
      <div class="modal-glass">
        <button id="close-modal" class="close-btn">&times;</button>
        <div class="modal-visual">
          <img id="modal-img" src="" alt="Project Visual" />
        </div>
        <div class="modal-info">
          <h2 id="modal-title">Project Title</h2>
          <p id="modal-desc">Detailed project description goes here.</p>
          <a id="modal-link" href="#" target="_blank" class="btn primary-btn">View Live</a>
        </div>
      </div>
    </div>

  </body>
</html>

<style>
  /* Global Resets */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    scroll-behavior: smooth;
  }

  body {
    background-color: #050505; 
    color: #e2e8f0;
    font-family: system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
    line-height: 1.6;
  }

  /* The Trippy Breathing Orb */
  .glow-orb {
    position: fixed;
    top: -100px;
    left: 50%;
    z-index: 0; 
    width: 80vw;
    height: 80vw;
    max-width: 800px;
    max-height: 800px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.45) 0%, rgba(236, 72, 153, 0.2) 40%, rgba(0, 0, 0, 0) 70%);
    pointer-events: none;
    animation: breathe 8s infinite alternate ease-in-out;
  }

  /* Noise Texture Overlay */
  .noise-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1;
    pointer-events: none;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  @keyframes breathe {
    0% { transform: translateX(-50%) scale(1); filter: hue-rotate(0deg); }
    100% { transform: translateX(-50%) scale(1.1); filter: hue-rotate(45deg); }
  }

  /* Navigation */
  .navbar {
    position: fixed;
    top: 0;
    width: 100%;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 50;
    background: rgba(5, 5, 5, 0.5);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .logo {
    font-weight: 800;
    font-size: 1.25rem;
    color: #fff;
    letter-spacing: 1px;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    color: #cbd5e1;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: #f472b6;
  }

  /* Layout */
  .container {
    position: relative;
    z-index: 10;
    max-width: 1100px;
    margin: 0 auto;
    padding: 8rem 2rem 4rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  section {
    width: 100%;
    margin-bottom: 8rem;
  }

  .section-title {
    font-size: 2.5rem;
    color: #fff;
    margin-bottom: 3rem;
    text-align: center;
  }

  /* Frosted Glass Containers (Reusable) */
  .glass-box {
    background: rgba(20, 20, 25, 0.4);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }

  /* Hero Section */
  .hero {
    padding: 4rem 3rem;
    width: 100%;
  }

  .hero-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 850px) {
    .hero-split {
      grid-template-columns: 1.2fr 0.8fr;
      text-align: left;
    }
    .button-group {
      justify-content: flex-start;
    }
    .description {
      margin: 0 0 3rem 0;
    }
  }

  .floating-shroom {
    width: 100%;
    max-width: 400px;
    border-radius: 20px;
    box-shadow: 0 0 40px rgba(168, 85, 247, 0.3);
    animation: float 6s ease-in-out infinite;
    display: block;
    margin: 0 auto;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  .neon-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 900;
    background: linear-gradient(to right, #c084fc, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: #e2e8f0;
    font-weight: 500;
    margin-bottom: 2rem;
  }

  .highlight {
    color: #f472b6; 
    text-shadow: 0 0 15px rgba(244, 114, 182, 0.4);
  }

  .description {
    font-size: 1.125rem;
    color: #94a3b8;
    max-width: 700px;
    margin: 0 auto 3rem auto;
  }

  /* Services Section */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .service-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    text-align: center;
    transition: all 0.3s ease;
  }

  .service-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(168, 85, 247, 0.3);
  }

  .service-card .icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .service-card h3 {
    color: #fff;
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .service-card p {
    color: #94a3b8;
    font-size: 0.95rem;
  }

  /* Portfolio Section */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr; 
    gap: 2rem;
    width: 100%;
  }

  @media (min-width: 850px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project-card {
    background: rgba(20, 20, 25, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 2rem;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 280px;
    cursor: pointer;
  }

  .project-card:hover {
    transform: translateY(-10px);
    border-color: rgba(168, 85, 247, 0.5);
    box-shadow: 0 10px 30px rgba(168, 85, 247, 0.15);
    background: rgba(30, 30, 40, 0.6);
  }

  .project-content h3 {
    font-size: 1.5rem;
    color: #fff;
    margin-bottom: 1rem;
  }

  .project-content p {
    color: #94a3b8;
    margin-bottom: 1.5rem;
    font-size: 1rem;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .tech-stack span {
    background: rgba(168, 85, 247, 0.1);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.2);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Contact Section */
  .contact-card {
    padding: 4rem 3rem;
  }

  .contact-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 850px) {
    .contact-split {
      grid-template-columns: 1fr 1fr;
      text-align: left;
    }
  }

  .contact-visual {
    text-align: center;
  }

  .weird-bounce-logo {
    max-width: 250px;
    border-radius: 50%;
    margin-bottom: 2rem;
    animation: weirdBounce 4s infinite cubic-bezier(0.28, 0.84, 0.42, 1);
  }

  @keyframes weirdBounce {
    0%, 100% { transform: translateY(0) scale(1) rotate(0deg); }
    50% { transform: translateY(-25px) scale(1.05) rotate(5deg); box-shadow: 0 20px 40px rgba(168, 85, 247, 0.4); }
  }

  .contact-visual h2 {
    font-size: 2.5rem;
    color: #fff;
    margin-bottom: 1rem;
  }

  .contact-visual p {
    color: #cbd5e1;
    font-size: 1.125rem;
  }

  /* Contact Form Specifics */
  .custom-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .calendly-box {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .calendly-box h3 {
    color: #fff;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  
  .calendly-box p {
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .contact-mushroom {
    width: 120px;
    margin-top: 3rem;
    opacity: 0.8;
    filter: drop-shadow(0 0 15px rgba(168, 85, 247, 0.4));
    animation: float 6s ease-in-out infinite;
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: left;
  }

  .input-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #cbd5e1;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .input-group input, .input-group textarea {
    width: 100%;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: #fff;
    font-family: inherit;
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .input-group input:focus, .input-group textarea:focus {
    outline: none;
    border-color: #a855f7;
    background: rgba(168, 85, 247, 0.05);
  }

  .submit-btn {
    width: 100%;
    cursor: pointer;
    font-size: 1.1rem;
  }

  .form-status {
    text-align: center;
    padding: 2rem;
    background: rgba(168, 85, 247, 0.1);
    border: 1px solid #a855f7;
    border-radius: 12px;
    margin-top: 1rem;
  }

  .form-status h3 {
    color: #f472b6;
    margin-bottom: 0.5rem;
  }

  .hidden {
    display: none !important;
  }

  /* Buttons */
  .button-group {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.85rem 2.5rem;
    border-radius: 9999px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .primary-btn {
    background: linear-gradient(45deg, #a855f7, #ec4899);
    color: #fff;
    box-shadow: 0 4px 20px rgba(236, 72, 153, 0.3);
    border: none;
  }

  .primary-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 6px 25px rgba(236, 72, 153, 0.5);
  }

  .secondary-btn {
    background-color: rgba(255, 255, 255, 0.05);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .secondary-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: #c084fc;
    color: #c084fc;
  }

  /* Modal System */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 100;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-glass {
    background: rgba(20, 20, 25, 0.85);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 24px;
    width: 90%;
    max-width: 800px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.2);
    position: relative;
    transform: translateY(20px);
    transition: all 0.3s ease;
  }

  .modal-overlay.active .modal-glass {
    transform: translateY(0);
  }

  .close-btn {
    position: absolute;
    top: 15px;
    right: 20px;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    z-index: 10;
    transition: color 0.2s ease;
  }

  .close-btn:hover {
    color: #f472b6;
  }

  /* Upgraded Modal Visuals (Built-in Mockup Effect) */
  .modal-visual {
    padding: 2.5rem; 
    background: radial-gradient(circle, rgba(168, 85, 247, 0.15) 0%, rgba(20, 20, 25, 1) 100%);
    display: flex;
    justify-content: center;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .modal-visual img {
    width: auto;
    max-width: 100%;
    max-height: 400px;
    object-fit: contain;
    border-radius: 18px; 
    border: 6px solid #141419; 
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), 0 0 20px rgba(168, 85, 247, 0.2);
  }

  .modal-info {
    padding: 2.5rem;
    text-align: center;
  }

  .modal-info h2 {
    font-size: 2rem;
    color: #fff;
    margin-bottom: 1rem;
  }

  .modal-info p {
    color: #cbd5e1;
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }
</style>

<script>
  // Wait for the DOM to load
  document.addEventListener('DOMContentLoaded', () => {
    
    // --- MODAL LOGIC ---
    const cards = document.querySelectorAll('.project-card');
    const modal = document.getElementById('project-modal');
    const closeBtn = document.getElementById('close-modal');
    
    const modalTitle = document.getElementById('modal-title');
    const modalDesc = document.getElementById('modal-desc');
    const modalImg = document.getElementById('modal-img') as HTMLImageElement;
    const modalLink = document.getElementById('modal-link') as HTMLAnchorElement;

    cards.forEach(card => {
      card.addEventListener('click', () => {
        modalTitle.textContent = card.getAttribute('data-title');
        modalDesc.textContent = card.getAttribute('data-desc');
        modalImg.src = card.getAttribute('data-img');
        
        const link = card.getAttribute('data-link');
        if (link && link !== '#') {
          modalLink.href = link;
          modalLink.style.display = 'inline-block';
        } else {
          modalLink.style.display = 'none';
        }
        
        modal.classList.add('active');
        document.body.style.overflow = 'hidden'; 
      });
    });

    const closeModal = () => {
      modal.classList.remove('active');
      document.body.style.overflow = 'auto'; 
    };

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // --- MAKE.COM WEBHOOK FORM LOGIC ---
    const form = document.getElementById('tma-contact-form') as HTMLFormElement;
    const formStatus = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');
    const timestampField = document.getElementById('timestamp') as HTMLInputElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // 1. Check Honeypot (Bot Protection)
      const honeypot = (form.elements.namedItem('website') as HTMLInputElement).value;
      if (honeypot) {
        console.log("Bot detected. Silently failing.");
        return; 
      }

      // 2. Set Timestamp just before sending
      timestampField.value = new Date().toISOString();

      // 3. Update button state
      submitBtn.textContent = "Transmitting...";
      submitBtn.style.opacity = "0.7";
      submitBtn.style.pointerEvents = "none";

      // 4. Gather Data
      const formData = {
        firstName: (form.elements.namedItem('firstName') as HTMLInputElement).value,
        lastName: (form.elements.namedItem('lastName') as HTMLInputElement).value,
        email: (form.elements.namedItem('email') as HTMLInputElement).value,
        phone: (form.elements.namedItem('phone') as HTMLInputElement).value,
        message: (form.elements.namedItem('message') as HTMLInputElement).value,
        timestamp: timestampField.value
      };

      try {
        const makeWebhookUrl = 'https://hook.us2.make.com/li9iehmu89acar9sjdoa8ghmkip1w8bi'; 

        const response = await fetch(makeWebhookUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(formData)
        });

        // Make.com usually returns a 200 OK with "Accepted" text
        if (response.ok) {
          form.style.display = 'none';
          formStatus.classList.remove('hidden');
        } else {
          throw new Error('Network response was not ok');
        }
      } catch (error) {
        console.error('Error submitting form:', error);
        submitBtn.textContent = "Error. Try Again.";
        submitBtn.style.opacity = "1";
        submitBtn.style.pointerEvents = "auto";
        submitBtn.style.background = "#ef4444"; 
      }
    });

  });
</script>